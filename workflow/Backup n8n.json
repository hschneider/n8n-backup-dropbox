    {
      "parameters": {
        "jsCode": "const KEEP = 10;  // Number of folders to keep\nconst FOLDER = \"backup\";  // Backup folder\n\nconst items = $input.all();\nlet entries = [];\n\n// Collect raw entries returned by Dropbox List Folder\nfor (const item of items) {\n  if (item.json && Array.isArray(item.json.entries)) {\n    entries.push(...item.json.entries);\n  } else if (item.json) {\n    entries.push(item.json);\n  }\n}\n\n// Target only actual workflow backup directories\n//\nconst backupFolders = entries.filter(entry => {\n  const tag = entry['.tag'] || entry.type;\n  const name = entry.name || '';\n  \n  const isFolder = tag === 'folder';\n  const isNotFile = !name.endsWith('.json');\n  const matchesBackupName = name.endsWith('Workflows');\n  \n  return isFolder && isNotFile && matchesBackupName;\n});\n\n// Newest folders first \n//\nbackupFolders.sort((a, b) => b.name.localeCompare(a.name));\n\nif (backupFolders.length <= KEEP) {\n  return []; // Output nothing -> Delete node will not execute\n}\n\nconst foldersToDelete = backupFolders.slice(KEEP);\n\nreturn foldersToDelete.map(folder => ({\n  json: {\n    name: folder.name,\n    path: folder.pathDisplay || folder.pathLower || `/{FOLDER}/${folder.name}`\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
